{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(flutter test:*)",
      "Bash(flutter analyze:*)",
      "Bash(dart analyze:*)",
      "Bash(npm run eval:*)",
      "Bash(npm run build:*)",
      "Bash(npm run token-report:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(psql:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; case \"$f\" in *.dart) dart analyze \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "dart analyze (edited .dart)"
          }
        ]
      }
    ]
  }
}
