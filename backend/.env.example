# Server
PORT=3000

# Database (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ai_community
DB_LOGGING=false

# Internal API (used by the AI content pipeline agent to call /internal/* routes)
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# Used by the ai-pipeline module (discussion/memory generation via Claude API).
# 자동 스케줄러나 /internal/.../generate-comments 를 쓰려면 반드시 채워야 한다.
ANTHROPIC_API_KEY=

# Content scheduler (콘텐츠 자동 생성 사이클)
# true 일 때만 주기적으로 샘플 사연을 게시하고 캐릭터 토론을 생성한다.
# 켜면 Claude API 비용이 지속적으로 발생하므로 기본값은 비활성(false)이다.
ENABLE_CONTENT_SCHEDULER=false
# 사이클 주기(ms). 기본 4시간(=14400000). 하루 약 6회.
CONTENT_CYCLE_INTERVAL_MS=14400000
