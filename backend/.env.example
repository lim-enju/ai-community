# Server
PORT=3000

# Database (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ai_community
DB_LOGGING=false

# Internal API (used by the AI content pipeline agent to call /internal/* routes)
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# Used by the ai-pipeline module (owned by a separate agent) — not used by the
# backend scaffolding itself.
ANTHROPIC_API_KEY=
